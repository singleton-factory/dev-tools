{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "ai-proxy/qwen3.8-27b",
  "provider": {
    "ai-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bubbles AI Proxy",

      "options": {
        "baseURL": "http://ai-proxy.lan:9931/v1",
        "apiKey": "sk-5kDw8qGdgwLcUrHBMUkO_g"
      },

      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3.8-27b-parallel": {
          "name": "Qwen 3.8 27B Parallel",
          "limit": {
            "context": 57344,
            "output": 8192
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "ai-proxy",
        "effect": "allow"
      }
    ]
  },
  "agent": {
    "explorer": {
      "description": "Read-only repository analyst. Use before substantial or unclear changes to locate relevant code, call sites, tests, constraints and likely root causes.",
      "mode": "subagent",
      "model": "ai-proxy/qwen3.8-27b",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/explorer.md}",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny"
      }
    },

    "verifier": {
      "description": "Read-only verification agent. Use after implementation to run targeted tests, builds, linters and inspect behavior for regressions. Never modify files.",
      "mode": "subagent",
      "model": "ai-proxy/qwen3.8-27b",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/verifier.md}",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny"
      }
    },

    "reviewer": {
      "description": "Independent read-only code reviewer. Use after implementation and verification to inspect the git diff for correctness, regressions, edge cases, security and maintainability.",
      "mode": "subagent",
      "model": "ai-proxy/qwen3.8-27b",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/reviewer.md}",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny"
      }
    }
  }
}
