{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "custom_openai/qwen3.8-flash-next",
  "providers": {
    "custom_openai": {
      "name": "Bubbles AI Proxy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ai-proxy.lan:9931/v1",
        "apiKey": "sk-5kDw8qGdgwLcUrHBMUkO_g"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen 3.8 Main",
          "limit": {
            "context": 65536,
            "output": 12288
          }
        },
        "qwen3.8-flash-next-implementer": {
          "modelID": "qwen3.8-flash-next",
          "name": "Qwen 3.8 Implementer",
          "limit": {
            "context": 196608,
            "output": 16384
          }
        },
        "qwen3.8-flash-next-reviewer": {
          "modelID": "qwen3.8-flash-next",
          "name": "Qwen 3.8 Reviewer",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "custom_openai",
        "effect": "allow"
      }
    ]
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "implementer",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "reviewer",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean -f*",
      "effect": "deny"
    }
  ]
}