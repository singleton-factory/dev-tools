{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "ai-proxy/qwen3.8-27b",
  "provider": {
    "ai-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bubbles AI Proxy",

      "options": {
        "baseURL": "http://ai-proxy.lan:9931/v1",
        "apiKey": "dummy"
      },

      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3.8-27b-parallel": {
          "name": "Qwen 3.8 27B Parallel",
          "limit": {
            "context": 57344,
            "output": 8192
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "ai-proxy",
        "effect": "allow"
      }
    ]
  }
}