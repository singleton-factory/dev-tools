{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "custom_openai/qwen3.8-flash-next",
  "providers": {
    "custom_openai": {
      "name": "Bubbles AI Proxy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ai-proxy.lan:9931/v1"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen 3.8 Flash Next",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.8-flash-next-parallel": {
          "modelID": "qwen3.8-flash-next",
          "name": "Qwen 3.8 Flash Next Parallel",
          "limit": {
            "context": 65536,
            "output": 12288
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "custom_openai",
        "effect": "allow"
      }
    ]
  }
}